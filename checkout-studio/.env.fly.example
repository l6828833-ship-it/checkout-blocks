# Set these as Fly secrets. Never commit real values to this file.
# Supabase: use the Shared Pooler connection string from the Connect panel.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres
JWT_SECRET=replace-with-a-long-random-secret
SHOPIFY_API_KEY=your-shopify-client-id
SHOPIFY_API_SECRET=your-shopify-client-secret

# Optional only if you retain the non-Shopify Manus preview/login fallback.
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
